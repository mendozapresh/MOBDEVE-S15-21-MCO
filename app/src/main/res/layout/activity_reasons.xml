<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:padding="24dp">

    <ImageButton
        android:id="@+id/btnBackReasons"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@android:drawable/ic_menu_revert"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvReasonsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:text="What's happening?"
        android:textColor="@color/black"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvReasonsSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Select factors that may be influencing your current state"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvReasonsTitle" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/btnNextReasons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvReasonsSubtitle">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupReasons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp">

            <!-- Clinical/Depression/Bipolar Factors -->
            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lack of sleep"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oversleeping"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Missed medication"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Social withdrawal"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conflict with others"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Work/School pressure"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Financial stress"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Physical pain"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Low motivation"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ruminating thoughts"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Routine change"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alcohol/Caffeine"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <!-- Happy/Fun Things -->
            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productive day"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good social time"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Personal achievement"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Restful sleep"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Meaningful hobby"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Outdoor time"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

            <com.google.android.material.chip.Chip
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Other"
                app:chipBackgroundColor="@color/gray_100"
                app:chipStrokeWidth="0dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.SteadyMe.Capsule" />

        </com.google.android.material.chip.ChipGroup>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNextReasons"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginBottom="24dp"
        android:text="Next"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

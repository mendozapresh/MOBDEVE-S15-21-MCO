<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="20dp"><TextView android:id="@+id/tvManualTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Manual Log" android:textSize="28sp" android:textStyle="bold" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent"/><TextView android:id="@+id/tvManualHint" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tap the emotion that best describes your current state." android:textColor="@color/text_secondary" app:layout_constraintTop_toBottomOf="@id/tvManualTitle" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/><GridLayout android:id="@+id/gridEmotions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:columnCount="4" app:layout_constraintTop_toBottomOf="@id/tvManualHint" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"><com.google.android.material.button.MaterialButton android:id="@+id/btnHappy" android:text="😊\nHappy" style="@style/Widget.Material3.Button.TextButton"/><com.google.android.material.button.MaterialButton android:id="@+id/btnElated" android:text="🤩\nElated" style="@style/Widget.Material3.Button.TextButton"/><com.google.android.material.button.MaterialButton android:id="@+id/btnCalm" android:text="😌\nCalm" style="@style/Widget.Material3.Button.TextButton"/><com.google.android.material.button.MaterialButton android:id="@+id/btnTired" android:text="😴\nTired" style="@style/Widget.Material3.Button.TextButton"/><com.google.android.material.button.MaterialButton android:id="@+id/btnSad" android:text="😢\nSad" style="@style/Widget.Material3.Button.TextButton"/><com.google.android.material.button.MaterialButton android:id="@+id/btnAnxious" android:text="😰\nAnxious" style="@style/Widget.Material3.Button.TextButton"/><com.google.android.material.button.MaterialButton android:id="@+id/btnOverwhelmed" android:text="😣\nOverwhelmed" style="@style/Widget.Material3.Button.TextButton"/><com.google.android.material.button.MaterialButton android:id="@+id/btnAngry" android:text="😠\nAngry" style="@style/Widget.Material3.Button.TextButton"/></GridLayout><TextView android:id="@+id/tvSelectedEmotion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/primary" app:layout_constraintTop_toBottomOf="@id/gridEmotions" app:layout_constraintStart_toStartOf="parent"/><com.google.android.material.textfield.TextInputLayout android:id="@+id/tilNotes" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:hint="Notes (optional)" app:layout_constraintTop_toBottomOf="@id/tvSelectedEmotion" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"><com.google.android.material.textfield.TextInputEditText android:id="@+id/etNotes" android:layout_width="match_parent" android:layout_height="100dp" android:gravity="top" android:inputType="textMultiLine"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.button.MaterialButton android:id="@+id/btnSaveMood" android:layout_width="0dp" android:layout_height="52dp" android:enabled="false" android:text="Save mood" app:layout_constraintTop_toBottomOf="@id/tilNotes" android:layout_marginTop="18dp" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/></androidx.constraintlayout.widget.ConstraintLayout>

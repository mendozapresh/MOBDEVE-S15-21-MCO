<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvManualTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manual Log"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvManualHint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Tap the emotion that best describes your current state."
        android:textColor="@color/text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvManualTitle" />

    <GridLayout
        android:id="@+id/gridEmotions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:columnCount="4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvManualHint">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHappy"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="😊\nHappy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnElated"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="🤩\nElated" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCalm"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="😌\nCalm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTired"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="😴\nTired" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSad"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="😢\nSad" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnxious"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="😰\nAnxious" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOverwhelmed"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="😣\nOverwhelmed" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAngry"
            style="@style/Widget.Material3.Button.TextButton"
            android:text="😠\nAngry" />

    </GridLayout>

    <TextView
        android:id="@+id/tvSelectedEmotion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gridEmotions" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNotes"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:hint="Notes (optional)"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSelectedEmotion">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNotes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:gravity="top"
            android:inputType="textMultiLine" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveMood"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:enabled="false"
        android:text="Save mood"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilNotes" />

</androidx.constraintlayout.widget.ConstraintLayout>
